#!/usr/bin/env bash
# Gradle wrapper script
# This file is generated by Gradle and should be committed to version control

set -e

# Determine the Java command to use
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH."
fi

# Use the Gradle wrapper JAR
APP_HOME="$(cd "$(dirname "$0")" && pwd -P)"
GRADLE_WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# Download Gradle wrapper if not present
if [ ! -f "$GRADLE_WRAPPER_JAR" ]; then
    echo "Gradle wrapper not found. Using system Gradle instead."
    exec gradle "$@"
fi

# Execute Gradle
exec "$JAVACMD" -jar "$GRADLE_WRAPPER_JAR" "$@"
